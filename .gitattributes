# GitHub Linguist Language Breakdown Overrides
# Ensures Python AI & Algorithmic Core is highlighted as the primary language of NETRA-RAIL

# Vendor frontend UI routes & generated bundles
src/**/*.tsx linguist-vendored=true
src/**/*.ts linguist-vendored=true
src/routeTree.gen.ts linguist-generated=true
package-lock.json linguist-generated=true
bun.lock linguist-generated=true

# Force Python as detectable core application code
backend/*.py linguist-detectable=true
backend/**/*.py linguist-detectable=true
